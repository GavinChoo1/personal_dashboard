# =============================================================================
# Root .gitignore for Personal Dashboard
# =============================================================================

# Credentials, Keys & Secrets (CRITICAL)
*service-account*.json
*credentials*.json
token.json
*.key
*.pem
.env
.env.*
!.env.example

# Terraform State & Plugins
terraform/.terraform/
terraform/.terraform.lock.hcl
*.tfstate
*.tfstate.*
terraform/terraform.tfvars

# Python & Virtual Environments
backend/.venv/
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Databases & SQLite
*.db
*.sqlite
*.sqlite3
backend/email_analyzer.db

# Node.js / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# External Data & Google Drive staging
backend/external_data/
*.parquet
*.jsonl

# IDE & Operating System
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.log
